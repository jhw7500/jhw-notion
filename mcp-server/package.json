{
  "name": "jhw-notion-mcp",
  "version": "1.0.0",
  "description": "Notion AI Workspace MCP Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && chmod +x dist/control/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run -c vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@notionhq/client": "^5.20.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.3"
  },
  "bin": {
    "jhw-control": "dist/control/cli.js"
  }
}
