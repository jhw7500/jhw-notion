NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Live integration test (P2) ---
# `RUN_LIVE_NOTION_TESTS=1`이면 *.live.test.ts가 sandbox DB를 사용해 실 Notion API를 호출.
# 운영 DB(NOTION_CONFIG.databases) 보호를 위해 sandbox는 별도 페이지 안에 격리되어 있다.
# wrapper 페이지: jhw-notion sandbox (live test) — 2026-04-30 생성
RUN_LIVE_NOTION_TESTS=
NOTION_SANDBOX_DB_PROJECTS=ea26c7b8-b1fb-463d-9aeb-4126f2c90538
NOTION_SANDBOX_DB_DECISION_LOG=2a9a99dd-5af9-4d47-aca7-bf7823746749
NOTION_SANDBOX_DB_KNOWLEDGE_BASE=87fbf094-91f9-40d9-8132-9b36a363d826
NOTION_SANDBOX_DB_REFERENCES=48f9c9ff-7b7f-4041-b3e4-43cf4a1ec2bf
NOTION_SANDBOX_DB_PREFERENCES=a00bb3b4-c3ff-472d-b77c-2b86bde31284

# --- Project-control host configuration (non-secret) ---
# Pin these three paths to immutable absolute host paths. Do not use `$HOME`,
# symlinks, alternate Registry checkouts, or per-process state directories.
JHW_REGISTRY_DIR=/absolute/path/to/private-registry-checkout
JHW_REGISTRY_REMOTE=origin
JHW_REGISTRY_BRANCH=main
JHW_WORKTREE_ROOT=/absolute/path/to/project-worktrees
JHW_BUILD_HOST=
JHW_GITHUB_OWNER=
JHW_PROJECT_NUMBER=
JHW_REGISTRY_REPOSITORY=
JHW_PREFLIGHT_PROJECT_ITEM_ID=
JHW_PREFLIGHT_REGISTRY_ISSUE_NUMBER=
JHW_CONTROL_STATE_DIR=/absolute/path/to/jhw-control-state

# GH_PROJECT_TOKEN must be a distinct short-lived classic PAT with exactly the
# `project` scope. GH_REPO_TOKEN must be restricted to the Registry plus the
# source repositories being registered, with only required Issue/metadata access.
# Both must be injected by the host credential store for each process.
# Do not place tokens in this .env file or commit them to version control.
